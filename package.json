{
  "name": "crapi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": "22.12.0",
    "pnpm": "9.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:toolchain": "node tooling/check-toolchain.mjs",
    "check:secrets": "node tooling/check-secrets.mjs",
    "check:ci": "pnpm format:check && pnpm check:toolchain && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security": "pnpm check:secrets && pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.12.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10"
  }
}
